@section scripts{
    <script src="~/Content/clients/plugins/chart.js/Chart.min.js"></script>
    <script src="~/Content/assets/plugins/moment/moment.min.js"></script>
    <script>
        function formatVietnamCurrency(amount) {
            if (isNaN(amount)) return "0 ₫";
            return amount.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });
        }

        let chartInstance = null;
        let currentPage = 1;
        let pageSize = 5;
        let pagedData = [];

        $(function () {
            function loadChart(mode) {
                let arrDoanhThu = [];
                let arrLoiNhuan = [];
                let arrLabel = [];

                let url = (mode === "monthly") ? '/Statistical/GetMonthlyStatistical' : '/Statistical/GetStatistical';

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (rs) {
                        pagedData = rs.Data;
                        currentPage = 1;

                        $.each(rs.Data, function (i, item) {
                            let label = mode === "monthly"
                                ? (item.Thang < 10 ? "0" + item.Thang : item.Thang) + "/" + item.Nam
                                : moment(item.Date).format('DD/MM/yyyy');

                            arrLabel.push(label);
                            arrDoanhThu.push(item.DoanhThu);
                            arrLoiNhuan.push(item.LoiNhuan);
                        });

                        const chartData = {
                            labels: arrLabel,
                            datasets: [
                                {
                                    label: 'Doanh thu',
                                    backgroundColor: 'rgba(210, 214, 222, 1)',
                                    borderColor: 'rgba(210, 214, 222, 1)',
                                    data: arrDoanhThu
                                },
                                {
                                    label: 'Lợi nhuận',
                                    backgroundColor: 'rgba(60,141,188,0.9)',
                                    borderColor: 'rgba(60,141,188,0.8)',
                                    data: arrLoiNhuan
                                }
                            ]
                        };

                        const ctx = $('#barChart').get(0).getContext('2d');
                        if (chartInstance) chartInstance.destroy();

                        chartInstance = new Chart(ctx, {
                            type: 'bar',
                            data: chartData,
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                datasetFill: false
                            }
                        });

                        renderPagination();
                        load_data(mode);
                    },
                    error: function () {
                        alert("Lỗi khi tải dữ liệu thống kê.");
                    }
                });
            }

            // Khi đổi chế độ
            $('input[name="statMode"]').change(function () {
                let selectedMode = $(this).val();
                loadChart(selectedMode);
            });

            // Mặc định: theo ngày
            loadChart("daily");

            // Gọi khi chuyển trang
            window.goToPage = function (page) {
                currentPage = page;
                const mode = $('input[name="statMode"]:checked').val();
                load_data(mode);
                renderPagination();
            }

            function renderPagination() {
                var totalPages = Math.ceil(pagedData.length / pageSize);
                var paginationHtml = '';
                for (var i = 1; i <= totalPages; i++) {
                    paginationHtml += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="javascript:void(0);" onclick="goToPage(${i})">${i}</a>
                            </li>`;
                }
                $('#pagination-container').html(paginationHtml);
            }
        });

        function load_data(mode) {
            let strHtml = "";
            var start = (currentPage - 1) * pageSize;
            var end = start + pageSize;
            var pageData = pagedData.slice(start, end);

            $.each(pageData, function (i, item) {
                var label = mode === "monthly"
                    ? (item.Thang < 10 ? "0" + item.Thang : item.Thang) + "/" + item.Nam
                    : moment(item.Date).format('DD/MM/yyyy');

                strHtml += "<tr>";
                strHtml += "<td>" + (start + i + 1) + "</td>";
                strHtml += "<td>" + label + "</td>";
                strHtml += "<td>" + formatVietnamCurrency(item.DoanhThu) + "</td>";
                strHtml += "<td>" + formatVietnamCurrency(item.LoiNhuan) + "</td>";
                strHtml += "</tr>";
            });

            $('#load_data').html(strHtml);
        }
    </script>
}

