                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ngày/Tháng</th>
                                <th>Doanh thu</th>
                                <th>Lợi nhuận</th>
                            </tr>
                        </thead>
                        <tbody id="load_data"></tbody>
                        @*Phân trang*@
                        <tfoot>
                            <tr>
                                <td colspan="4">
                                    <nav aria-label="Page navigation">
                                        <ul class="pagination" id="pagination-container"></ul>
                                    </nav>
                                </td>
                            </tr>
                        </tfoot>

                    </table>
                </div>
            </div>
        </div>

        <div class="card-footer">
            📊 Gốm Sứ Bình Xuyên - Cập nhật lúc @DateTime.Now.ToString("HH:mm dd/MM/yyyy")
        </div>
    </div>
</section>

