@model WebBanHangOnline.Models.EF.Adv
@{
    ViewBag.Title = "Thêm Mới Quảng Cáo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@section naviheader{
    <!-- Left navbar links -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang Chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/adv" class="nav-link">Quảng Cáo</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="#" class="nav-link">Thêm Mới</a>
        </li>
    </ul>
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Thêm Mới Quảng Cáo</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Quảng Cáo</a></li>
                    <li class="breadcrumb-item active">Thêm Mới</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<!-- Main content -->
<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Thông Tin Thêm Mới Quảng Cáo</h3>
        </div>
        <div class="card-body">
            <div class="bs-stepper-content">
                @using (Html.BeginForm("Add", "Adv", FormMethod.Post, new { }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true)

                    <div class="form-group">
                        <label>Tiêu Đề</label>
                        @Html.TextBoxFor(x => x.Title, new { @class = "form-control", @placeholder = "Tiêu đề quảng cáo" })
                        @Html.ValidationMessageFor(x => x.Title, null, new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Ảnh Đại Diện</label>
                        <div class="input-group">
                            <div class="custom-file">
                                @Html.TextBoxFor(x => x.Image, new { @id = "txtImage", @class = "form-control" })
                            </div>
                            <div class="input-group-append">
                                <input type="button" value="Tải Ảnh" onclick="BrowseServer('txtImage');" />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Mô Tả</label>
                        @*@Html.TextAreaFor(x => x.Description, new { @class = "form-control" })*@
                        @Html.TextAreaFor(x => x.Description, new { @class = "form-control", @id = "txtDescription" })
                    </div>

                    <div class="form-group">
                        <label>Link Chuyển Hướng</label>
                        @Html.TextBoxFor(x => x.Link, new { @class = "form-control", @placeholder = "https://..." })
                    </div>

                    <div class="form-group">
                        <label>Loại Quảng Cáo</label>
                        @Html.TextBoxFor(x => x.Type, new { @class = "form-control", @placeholder = "Ví dụ: slide, banner, sidebar..." })
                    </div>

                    <div class="form-group">
                        <label>Hiển Thị</label>
                        @Html.CheckBoxFor(x => x.IsActive, new { @checked = "@checked" })
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">Lưu</button>
                        <a href="/admin/adv" class="btn btn-danger">Quay Lại</a>
                    </div>
                }
            </div>
        </div>
        <div class="card-footer">
        </div>
    </div>
</section>

@section scripts{
    <script>
        $(document).ready(function () {
            CKEDITOR.replace('txtDescription', {
                customConfig: '/content/ckeditor/config.js',
                extraAllowedContent: 'span',
            });

            // Fix quan trọng: Đảm bảo nội dung từ CKEditor được sync về textarea trước khi submit
            $('form').submit(function () {
                for (instance in CKEDITOR.instances) {
                    CKEDITOR.instances[instance].updateElement();
                }
            });
        });

        function BrowseServer(field) {
            var finder = new CKFinder();
            finder.selectActionFunction = function (fileUrl) {
                document.getElementById(field).value = fileUrl;
            };
            finder.popup();
        }
    </script>
}