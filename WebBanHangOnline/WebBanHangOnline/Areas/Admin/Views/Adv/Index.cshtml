@model PagedList.IPagedList<WebBanHangOnline.Models.EF.Adv>
@using PagedList.Mvc;
@using PagedList;
@{
    ViewBag.Title = "Danh Sách Quảng Cáo";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
}

@section naviheader {
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin" class="nav-link">Trang Chủ</a>
        </li>
        <li class="nav-item d-none d-sm-inline-block">
            <a href="/admin/adv" class="nav-link">Danh Sách Quảng Cáo</a>
        </li>
    </ul>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Quản Lý Quảng Cáo</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title</h3>
            <div class="card-tools">
                <a href="/admin/adv/add" class="btn btn-success">Thêm Mới</a>
                <a href="#" class="btn btn-danger" id="BtnDeleteAll">Xóa</a>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-6">
                    @using (Html.BeginForm("Index", "Adv", new { area = "Admin" }, FormMethod.Get, new { @class = "form-inline my-2 my-lg-0" }))
                    {
                        <input class="form-control mr-sm-2" type="search" placeholder="Tìm kiếm..." aria-label="Search" name="SearchText" value="@ViewBag.SearchText" />
                        <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>
                    }
                </div>
            </div>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th><input type="checkbox" id="SelectAll" /></th>
                        <th>STT</th>
                        <th>Hình Ảnh</th>
                        <th>Tiêu Đề</th>
                        <th>Ngày Tạo</th>
                        <th>Hiển Thị</th>
                        <th style="width:150px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var index = (page - 1) * pageSize + 1;
                        foreach (var item in Model)
                        {
                            var strCheck = item.IsActive
                                ? "<i class='fa fa-check text-success'></i>"
                                : "<i class='fas fa-times text-danger'></i>";
                            <tr id="trow_@item.Id">
                                <td><input type="checkbox" class="cbkItem" value="@item.Id" /></td>
                                <td>@index</td>
                                <td><img src="@item.Image" width="60" /></td>
                                <td>@item.Title</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a href="#" data-id="@item.Id" class="btnActive">@Html.Raw(strCheck)</a>
                                </td>
                                <td>
                                    <a href="/admin/adv/edit/@item.Id" class="btn btn-sm btn-primary">Sửa</a>
                                    <a href="#" data-id="@item.Id" class="btn btn-sm btn-danger btnDelete">Xóa</a>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">Không có bản ghi nào!</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row">
                <div class="col-6"></div>
                <div class="col-6 text-right">
                    @Html.PagedListPager(Model, pageNumber => Url.Action("Index", new { page = pageNumber, SearchText = ViewBag.SearchText }))
                </div>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        $(document).ready(function () {
            // Xóa nhiều
            $('#BtnDeleteAll').click(function (e) {
                e.preventDefault();
                let ids = $('.cbkItem:checked').map(function () { return $(this).val(); }).get();
                if (ids.length === 0) {
                    alert("Vui lòng chọn ít nhất một bản ghi để xóa.");
                    return;
                }
                if (confirm("Bạn có muốn xóa các bản ghi đã chọn?")) {
                    $.post('/admin/adv/deleteAll', { ids: ids.join(",") }, function (rs) {
                        if (rs.success) location.reload();
                    });
                }
            });

            // Chọn tất cả
            $('#SelectAll').change(function () {
                $('.cbkItem').prop('checked', this.checked);
            });

            // Xóa 1 bản ghi
            $('.btnDelete').click(function () {
                const id = $(this).data("id");
                if (confirm("Bạn có chắc chắn muốn xóa bản ghi này?")) {
                    $.post('/admin/adv/delete', { id: id }, function (rs) {
                        if (rs.success) {
                            location.reload();
                            //$('#trow_' + id).remove();
                        }
                    });
                }
            });

            // Active/Inactive
            $('.btnActive').click(function (e) {
                e.preventDefault();
                const btn = $(this);
                const id = btn.data("id");
                $.post('/admin/adv/IsActive', { id: id }, function (rs) {
                    if (rs.success) {
                        btn.html(rs.isActive
                            ? "<i class='fa fa-check text-success'></i>"
                            : "<i class='fas fa-times text-danger'></i>");
                    }
                });
            });
        });
    </script>
}
