@model WebBanHangOnline.Models.EF.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    var i = 1;
    decimal tongTien = 0;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">
<style>
    .order-info {
        background-color: #f9f9f9;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        margin-top: 150px;
    }

    .table-wrapper {
        background-color: #fff;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    h2, h4 {
        font-weight: 600;
    }

    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
    }
</style>

<div class="container">
    <div class="order-info mb-5">
        <h2 class="mb-3">🧾 Chi tiết đơn hàng</h2>
        <hr />
        <p><strong>Mã đơn hàng:</strong> @Model.Code</p>
        <p><strong>Ngày đặt:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Khách hàng:</strong> @Model.CustomerName</p>
        <p><strong>SĐT:</strong> @Model.Phone</p>
        <p><strong>Địa chỉ:</strong> @Model.Address</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p>
            <strong>Trạng thái:</strong>
            @{
                var status = "Không xác định";
                var badgeColor = "secondary";
                switch (Model.Status)
                {
                    case 1: status = "Chưa thanh toán"; badgeColor = "warning"; break;
                    case 2: status = "Đã thanh toán"; badgeColor = "info"; break;
                    case 3: status = "Hoàn thành"; badgeColor = "success"; break;
                    case 4: status = "Đã hủy"; badgeColor = "danger"; break;
                }
            }
            <span class="badge bg-@badgeColor badge-status">@status</span>
        </p>
    </div>

    <div class="table-wrapper mb-4">
        <h4 class="mb-3">📦 Sản phẩm đã mua</h4>
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    var thanhTien = item.Quantity * item.Price;
                    tongTien += thanhTien;
                    <tr>
                        <td>@i</td>
                        <td>@item.Product.Title</td>
                        <td>@item.Quantity</td>
                        <td>@WebBanHangOnline.Common.Common.FormatNumber(item.Price, 0) ₫</td>
                        <td>@WebBanHangOnline.Common.Common.FormatNumber(thanhTien, 0) ₫</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-5">
        <a href="/account/profile" class="btn btn-outline-primary px-4">← Quay lại</a>
        <h4 class="text-danger"><strong>Tổng tiền:</strong> @WebBanHangOnline.Common.Common.FormatNumber(tongTien, 0) ₫</h4>
    </div>
</div>
