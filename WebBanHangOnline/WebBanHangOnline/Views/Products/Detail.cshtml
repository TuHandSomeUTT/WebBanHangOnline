@section scripts{
    <script src="~/Content/assets/js/single_custom.js"></script>
    <script>
        $(document).ready(function () {
            let isProcessingSingleAddToCart = false; // Cờ chống double click riêng cho trang chi tiết
            let productId = $('.btnAddToCartSingle').data('id'); // Lấy ID sản phẩm
            let initialAvailableQty = parseInt($('.btnAddToCartSingle').data('quantity-available')); // Số lượng tồn kho ban đầu (tồn kho thực tế)
            let $quantityValue = $('#quantity_value'); // Input chọn số lượng
            let $currentAvailableQtyDisplay = $('#current_available_qty'); // Span hiển thị tồn kho

            // Cập nhật hiển thị số lượng tồn kho ban đầu
            // Luôn hiển thị số lượng tồn kho THỰC TẾ cho mọi người
            $currentAvailableQtyDisplay.text(initialAvailableQty);
            // Giá trị tối đa trong input quantity vẫn là tồn kho thực tế
            $quantityValue.attr('max', initialAvailableQty);

            // Hàm cập nhật trạng thái nút add to cart và số lượng tồn kho
            // Hàm này bây giờ CHỈ CẬP NHẬT UI dựa trên tồn kho THỰC TẾ.
            // Nó KHÔNG CÒN TRỪ ĐI số lượng đã có trong giỏ của người dùng nữa.
            function updateAddToCartStateBasedOnRealStock() {
                let currentRequestedQty = parseInt($quantityValue.val());

                $currentAvailableQtyDisplay.text(initialAvailableQty); // Luôn hiển thị tồn kho thực tế

                // Nếu sản phẩm hết hàng trong kho thực tế
                if (initialAvailableQty <= 0) {
                    $quantityValue.val(0); // Đặt số lượng hiển thị về 0
                    $('.btnAddToCartSingle').addClass('disabled').attr('disabled', 'disabled'); // Vô hiệu hóa nút
                    alert("Sản phẩm đã hết hàng trong kho.");
                    return;
                }

                // Đảm bảo số lượng đang chọn không vượt quá tồn kho thực tế
                if (currentRequestedQty > initialAvailableQty) {
                    $quantityValue.val(initialAvailableQty); // Giảm số lượng về tồn kho thực tế
                    alert("Bạn chỉ có thể chọn tối đa " + initialAvailableQty + " sản phẩm.");
                } else if (currentRequestedQty <= 0) { // Đảm bảo số lượng chọn không về 0 hoặc âm
                    $quantityValue.val(1);
                }

                // Đảm bảo nút không bị disabled nếu có hàng trong kho
                if (initialAvailableQty > 0) {
                    $('.btnAddToCartSingle').removeClass('disabled').removeAttr('disabled');
                    // Nếu số lượng đang là 0 nhưng có hàng, đặt về 1 (nếu chưa phải 1)
                    if (parseInt($quantityValue.val()) === 0) {
                        $quantityValue.val(1);
                    }
                }
            }

            // Gọi hàm cập nhật trạng thái khi trang load
            updateAddToCartStateBasedOnRealStock();

            // Xử lý nút MINUS
            $('.quantity_selector .minus').on('click', function () {
                let currentVal = parseInt($quantityValue.val());
                if (currentVal > 1) { // Đảm bảo số lượng không nhỏ hơn 1
                    $quantityValue.val(currentVal - 1);
                }
            });

            // Xử lý nút PLUS
            $('.quantity_selector .plus').on('click', function () {
                let currentVal = parseInt($quantityValue.val());
                // Kiểm tra với số lượng tồn kho THỰC TẾ
                if (currentVal < initialAvailableQty) {
                    $quantityValue.val(currentVal + 1);
                } else {
                    alert("Bạn đã chọn số lượng tối đa hiện có trong kho.");
                }
            });

            // Xử lý thay đổi trực tiếp trên input
            $quantityValue.on('change', function () {
                let val = parseInt($(this).val());

                if (isNaN(val) || val < 1) {
                    $(this).val(1);
                } else if (val > initialAvailableQty) { // Kiểm tra với tồn kho THỰC TẾ
                    $(this).val(initialAvailableQty);
                    alert("Bạn đã chọn số lượng tối đa hiện có trong kho.");
                }
            });


            // Xử lý nút Add to Cart trên trang chi tiết sản phẩm
            $('.btnAddToCartSingle').off('click').on('click', function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                if (isProcessingSingleAddToCart) {
                    return;
                }
                isProcessingSingleAddToCart = true;

                var addQty = parseInt($quantityValue.val()); // Lấy số lượng từ input

                if (addQty <= 0) {
                    alert("Số lượng sản phẩm cần thêm phải lớn hơn 0.");
                    isProcessingSingleAddToCart = false;
                    return;
                }

                // *** ĐIỀU CHỈNH LỚN Ở ĐÂY: Gọi AJAX checkquantity TRƯỚC khi gọi addtocart ***
                // Lý do: Để kiểm tra tổng số lượng sau khi thêm có vượt quá tồn kho thực tế không
                // Đồng thời cập nhật lại số lượng có trong giỏ của người dùng ngay sau khi thêm thành công
                $.ajax({
                    url: '/shoppingcart/checkquantity', // Vẫn gọi checkquantity để lấy số lượng đã có trong giỏ
                    type: 'POST',
                    data: { id: productId },
                    success: function (res) {
                        var currentCartQty = parseInt(res.Quantity || 0); // Số lượng sản phẩm này hiện có trong giỏ của người dùng

                        // Kiểm tra tổng số lượng sau khi thêm có vượt quá tồn kho THỰC TẾ không
                        if (currentCartQty + addQty > initialAvailableQty) {
                            alert("Bạn chỉ có thể thêm tối đa " + (initialAvailableQty - currentCartQty) + " sản phẩm vào giỏ hàng. Tổng số lượng sẽ vượt quá tồn kho.");
                            isProcessingSingleAddToCart = false;
                            return;
                        }

                        // Nếu số lượng hợp lệ, tiến hành thêm vào giỏ
                        $.ajax({
                            url: '/shoppingcart/addtocart',
                            type: 'POST',
                            data: { id: productId, quantity: addQty }, // Gửi số lượng đã chọn
                            success: function (res2) {
                                if (res2.Success) {
                                    alert(res2.msg);
                                    $('#checkout_items').text(res2.Count); // Cập nhật tổng số lượng trên icon giỏ hàng

                                    // *** CẬP NHẬT initialAvailableQty NẾU BACKEND TRẢ VỀ TỒN KHO THỰC TẾ MỚI ***
                                    // Nếu backend của bạn có logic trừ tồn kho ngay khi addtocart (mà tôi không khuyến nghị)
                                    // Hoặc nếu bạn muốn cập nhật lại initialAvailableQty từ server sau khi giỏ hàng thay đổi
                                    // Tuy nhiên, theo hướng của chúng ta (thanh toán mới trừ), thì dòng này có thể bỏ qua
                                    // hoặc chỉ dùng để hiển thị lại initialAvailableQty nếu nó có thay đổi do người khác mua.
                                    // currentCartQty = res2.QuantityInCartForProduct || (currentCartQty + addQty); // Cập nhật số lượng trong giỏ của user
                                    // updateAddToCartStateBasedOnRealStock(); // Gọi lại để refresh UI nếu cần.

                                } else {
                                    alert(res2.msg || "Không thể thêm sản phẩm vào giỏ hàng. Vui lòng thử lại.");
                                }
                                isProcessingSingleAddToCart = false;
                            },
                            error: function (jqXHR, textStatus, errorThrown) {
                                console.error("Lỗi AJAX AddToCart:", textStatus, errorThrown, jqXHR.responseText);
                                alert("Đã xảy ra lỗi khi thêm sản phẩm vào giỏ hàng.");
                                isProcessingSingleAddToCart = false;
                            }
                        });
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.error("Lỗi AJAX CheckQuantity pre-AddToCart:", textStatus, errorThrown, jqXHR.responseText);
                        alert("Đã xảy ra lỗi khi kiểm tra số lượng sản phẩm trước khi thêm. Vui lòng thử lại.");
                        isProcessingSingleAddToCart = false;
                    }
                });
            });
        });
    </script>
}