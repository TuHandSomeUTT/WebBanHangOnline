﻿@model PagedList.PagedList<WebBanHangOnline.Models.EF.Wishlist>
@using PagedList.Mvc;
@using PagedList;
@{
    ViewBag.Title = "Danh Sách Sản Phẩm Yêu Thích";
}
<link rel="stylesheet" type="text/css" href="~/Content/assets/styles/main_styles.css">
<!-- Slider -->
<style>
    .news_section_container {
        margin-top: 180px;
    }

    .row-item-new {
        margin-bottom: 20px;
    }

    .title-news {
        font-size: 24px;
        border-bottom: 1px solid;
        padding: 15px 0;
        margin-bottom: 25px;
    }

    .img-box img {
        max-width: 100%;
        max-height: 100%;
    }
</style>
<div class="container news_section_container">
    <div class="row">
        <div class="col-md-12">
            <h1 class="title-news"> Sản phẩm yêu thích</h1>
        </div>
    </div>
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="row row-item-new">
                <div class="col-md-3">
                    <div class="img-box">
                        <a href="/chi-tiet/@item.Product.Alias-p@(item.ProductId)" title="@item.Product.Title"><img src="@item.Product.Image" alt="@item.Product.Title" /></a>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="content-box">
                        <h3><a href="/chi-tiet/@item.Product.Alias-p@(item.ProductId)" title="@item.Product.Title">@item.Product.Title</a></h3>
                        <div class="description-box">
                            @item.Product.Description
                        </div>
                    </div>
                </div>
                <div class="col-md-1">
                    <a href="javascript:void(0);" data-id="@item.Id" class="btn btn-danger btn-delete-wishlist">Xóa</a>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-6"></div>
            <div class="col-6" style="text-align:right;">
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
            </div>
        </div>
    }

</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('.btn-delete-wishlist').click(function (e) {
                e.preventDefault();
                var btn = $(this);
                var id = btn.data('id');

                if (confirm("Bạn có chắc muốn xóa sản phẩm này khỏi danh sách yêu thích?")) {
                    $.ajax({
                        url: '@Url.Action("DeleteFromWishlist", "Wishlist")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.Success) {
                                btn.closest('.row-item-new').remove(); // Xóa khỏi view
                                alert(res.Message);
                            } else {
                                alert(res.Message);
                            }
                        },
                        error: function () {
                            alert("Có lỗi xảy ra, vui lòng thử lại.");
                        }
                    });
                }
            });
        });
    </script>
}